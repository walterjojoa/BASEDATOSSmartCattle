# Copy to .env and fill in. .env is ignored by git: the string below carries
# the password, so publishing it hands over the whole database.
#
# Neon gives you this from the Connect button; sslmode=require is not optional.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Used by the scripts in database/tests/ so they never touch the real database
# by accident. Point it at a throwaway database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/smartcattle_test?sslmode=require
